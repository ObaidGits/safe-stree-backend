# SafeStree ML Backend Configuration

# Core feature flags for Phase 0
ENABLE_HAND_GESTURE=1
GESTURE_ENGINE=mediapipe_landmark
GESTURE_ACTIVE_MODEL=data/models/gestures/active_model.json
GESTURE_MIN_CONFIDENCE=0.80
GESTURE_CONFIRMATION_FRAMES=10
GESTURE_CONFIRMATION_WINDOW=12
GESTURE_TRIGGER_LABELS=SOS
GESTURE_TRAIN_MIN_SAMPLES_PER_CLASS=10
GESTURE_TRAIN_RECOMMENDED_SAMPLES_PER_CLASS=20
ENABLE_VOICE_SOS=1
VOICE_ENGINE=vosk
VOICE_MODEL_PATH=data/models/voice/vosk-model-small-en-us
VOICE_MODEL_VERSION=vosk_offline_v1
VOICE_SAMPLE_RATE=16000
VOICE_CHUNK_SIZE=4096
VOICE_CONFIRMATION_HITS=2
VOICE_CONFIRMATION_WINDOW_SECONDS=5
VOICE_TRIGGER_COOLDOWN_SECONDS=2
VOICE_MATCH_THRESHOLD=0.78
VOICE_HIGH_CONFIDENCE_THRESHOLD=0.92
VOICE_TRIGGER_PHRASES=help me,please help,i need help,save me,i am in danger,bachao,madad
ENABLE_GENDER_DETECTION=0
GENDER_ENGINE=openvino
GENDER_DEVICE=CPU
GENDER_MODEL_PATH=data/models/openvino/age-gender-recognition-retail-0013
FACE_MODEL_PATH=data/models/openvino/face-detection-retail-0004
GENDER_MODEL_VERSION=openvino_retail_0013_v1
FACE_MODEL_VERSION=openvino_face_0004_v1
GENDER_MIN_FACE_CONFIDENCE=0.40
GENDER_MIN_GENDER_CONFIDENCE=0.65
GENDER_ANALYZE_EVERY_N_FRAMES=6
GENDER_SMOOTHING_WINDOW=5
GENDER_MAX_FACES=5
GENDER_CROP_MARGIN=0.15
GENDER_USE_DEEPFACE_FALLBACK=1

# Camera and runtime
CAMERA_INDEX=0
MAX_CAMERA_INDEX=8
ENABLE_DISPLAY=1
LOCATION_CACHE_MAX_AGE_SECONDS=300

# Phase 8 hardening
ALERT_RETRY_QUEUE_DB_PATH=data/cache/alert_retry_queue.db
ALERT_RETRY_WORKER_INTERVAL_SECONDS=15
ALERT_RETRY_WORKER_BATCH_SIZE=5
ALERT_DISPATCH_MAX_ATTEMPTS=2
ALERT_IMAGE_RETENTION_DAYS=7
ALERT_RETENTION_SCAN_INTERVAL_SECONDS=300
STARTUP_HEALTH_REPORT_PATH=data/cache/startup_health_report.json
CAMERA_RECONNECT_MAX_ATTEMPTS=3

# Current camera identity and fallback site location
ML_CAMERA_ID=cam-main-gate-01
ML_CAMERA_NAME=Main Gate CCTV
ML_CAMERA_LOCATION_LABEL=College Main Gate
ML_CAMERA_LATITUDE=22.5726
ML_CAMERA_LONGITUDE=88.3639
ML_CAMERA_ACCURACY=20

# Preferred internal backend route
CCTV_INTERNAL_ENDPOINT=http://localhost:8000/api/v1/cctv/internal
CCTV_INTERNAL_SERVICE_TOKEN=your_internal_ml_service_token_here
CCTV_INTERNAL_SERVICE_NAME=backend_ml

# Legacy fallback route, kept for rollback/testing
CCTV_SOS_ENDPOINT=http://localhost:8000/api/v1/cctv
CCTV_API_KEY=your_cctv_api_key_here
