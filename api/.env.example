# SafeStree API Configuration

# Core server settings
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/safestree
DB_NAME=safestree

# Auth secrets
ACCESS_TOKEN_SECRET=change_me_access_token_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=change_me_refresh_token_secret
REFRESH_TOKEN_EXPIRY=7d

# CCTV / ML integration
CCTV_API_KEY=change_me_legacy_cctv_key
INTERNAL_ML_SERVICE_TOKEN=change_me_internal_ml_token

# Optional services used by other routes
OPENCAGE_API_KEY=
